# /etc/getfit/api.env — root:afra, 0640, read by getfit-api.service
GETFIT_DB=/home/afra/get-fit/getfit.db
GETFIT_HOST=127.0.0.1
GETFIT_PORT=8787
GETFIT_REQUIRE_TOKEN=1
GETFIT_WEB=/home/afra/get-fit/apps/web/dist
LOG_LEVEL=info

# phase A (shadow): read-only, no scheduler. phase B (live): both flipped.
GETFIT_READ_ONLY=1
SCHEDULER=off

# Telegram delivery (temporary; removed when the native app ships)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
